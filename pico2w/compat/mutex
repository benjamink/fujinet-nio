// <mutex> for newlib builds on the Pico SDK.
//
// arm-none-eabi libstdc++ has no gthreads, so <mutex> is empty. NIO's core uses
// std::mutex and lock guards (45 sites); this shim backs them with the Pico
// SDK's recursive mutex, which is safe across both RP2350 cores. Only the
// parts of <mutex> NIO uses are provided. Found before the toolchain's header
// because pico2w/compat is first on the include path.
#pragma once

#include "pico/mutex.h"

namespace std {

struct adopt_lock_t { explicit adopt_lock_t() = default; };
struct defer_lock_t { explicit defer_lock_t() = default; };
inline constexpr adopt_lock_t adopt_lock{};
inline constexpr defer_lock_t defer_lock{};

class mutex {
public:
    mutex() { recursive_mutex_init(&m_); }
    mutex(const mutex&) = delete;
    mutex& operator=(const mutex&) = delete;
    void lock() { recursive_mutex_enter_blocking(&m_); }
    bool try_lock() { return recursive_mutex_try_enter(&m_, nullptr); }
    void unlock() { recursive_mutex_exit(&m_); }
private:
    recursive_mutex_t m_;
};

using recursive_mutex = mutex;

template <class M>
class lock_guard {
public:
    explicit lock_guard(M& m) : m_(m) { m_.lock(); }
    lock_guard(M& m, adopt_lock_t) : m_(m) {}
    ~lock_guard() { m_.unlock(); }
    lock_guard(const lock_guard&) = delete;
    lock_guard& operator=(const lock_guard&) = delete;
private:
    M& m_;
};

template <class M>
class unique_lock {
public:
    unique_lock() noexcept = default;
    explicit unique_lock(M& m) : m_(&m) { m_->lock(); owns_ = true; }
    unique_lock(M& m, defer_lock_t) noexcept : m_(&m) {}
    unique_lock(unique_lock&& o) noexcept : m_(o.m_), owns_(o.owns_) { o.m_ = nullptr; o.owns_ = false; }
    unique_lock& operator=(unique_lock&& o) noexcept {
        if (owns_) m_->unlock();
        m_ = o.m_; owns_ = o.owns_; o.m_ = nullptr; o.owns_ = false;
        return *this;
    }
    ~unique_lock() { if (owns_) m_->unlock(); }
    void lock() { m_->lock(); owns_ = true; }
    void unlock() { m_->unlock(); owns_ = false; }
    bool owns_lock() const noexcept { return owns_; }
    M* mutex() const noexcept { return m_; }
private:
    M* m_{nullptr};
    bool owns_{false};
};

template <class M>
using scoped_lock = lock_guard<M>;

} // namespace std
