// <condition_variable> for newlib builds on the Pico SDK (see ./mutex).
//
// NIO's core is cooperative and its two users wait on a predicate set by
// another context. This shim polls the predicate with the lock released,
// sleeping 1 ms between checks. A real RTOS port would replace it.
#pragma once

#include <chrono>
#include "mutex"
#include "pico/time.h"

namespace std {

enum class cv_status { no_timeout, timeout };

class condition_variable {
public:
    void notify_one() noexcept {}
    void notify_all() noexcept {}

    template <class Pred>
    void wait(unique_lock<mutex>& lk, Pred pred) {
        while (!pred()) { lk.unlock(); sleep_ms(1); lk.lock(); }
    }

    template <class Rep, class Period, class Pred>
    bool wait_for(unique_lock<mutex>& lk, const chrono::duration<Rep, Period>& d, Pred pred) {
        const auto ms = chrono::duration_cast<chrono::milliseconds>(d).count();
        absolute_time_t until = make_timeout_time_ms(static_cast<uint32_t>(ms));
        while (!pred()) {
            if (absolute_time_diff_us(get_absolute_time(), until) <= 0) return pred();
            lk.unlock(); sleep_ms(1); lk.lock();
        }
        return true;
    }
};

} // namespace std
